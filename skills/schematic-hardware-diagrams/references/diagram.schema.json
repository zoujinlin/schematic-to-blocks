{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schematic hardware block diagram",
  "type": "object",
  "required": ["name", "pages"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"$ref": "#/$defs/id"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "locale": {"type": "string"},
    "theme": {"enum": ["dark", "light"]},
    "legend": {"$ref": "#/$defs/legend"},
    "palette": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
    "ui": {"type": "object", "additionalProperties": {"type": "string"}},
    "unresolved": {"$ref": "#/$defs/strings"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "source", "basis"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "source": {"type": "string", "minLength": 1},
      "basis": {"enum": ["schematic", "netlist", "datasheet", "inferred", "ocr-candidate", "synthetic"]},
      "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
      "page": {"type": "integer", "minimum": 1}, "locator": {"type": "string"}, "note": {"type": "string"}
    }}},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "legend": {"type": "object", "required": ["data", "control", "power", "reference"], "additionalProperties": false, "properties": {
      "data": {"type": "string"}, "control": {"type": "string"}, "power": {"type": "string"}, "reference": {"type": "string"}
    }},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "node": {"type": "object", "required": ["id", "x", "y", "w", "h", "title"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0},
      "w": {"type": "number", "exclusiveMinimum": 0}, "h": {"type": "number", "exclusiveMinimum": 0},
      "title": {"type": "string"}, "model": {"type": "string"}, "lines": {"$ref": "#/$defs/strings"},
      "kind": {"enum": ["normal", "external", "interface", "power", "power_external", "reference", "annotation", "optional"]},
      "category": {"enum": ["data", "control", "power", "reference"]},
      "evidence": {"$ref": "#/$defs/refs"},
      "details": {"type": "object", "additionalProperties": false, "properties": {
        "function": {"type": "string"}, "principle": {"type": "string"}, "interfaces": {"$ref": "#/$defs/strings"},
        "power": {"$ref": "#/$defs/strings"}, "uncertainty": {"type": "string"}
      }}
    }},
    "edge": {"type": "object", "required": ["source", "target", "points"], "properties": {
      "source": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"},
      "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}},
      "kind": {"enum": ["data", "control", "power", "reference"]}, "label": {"type": "string"},
      "both": {"type": "boolean"}, "end_arrow": {"type": "boolean"}, "dash": {"type": "boolean"},
      "evidence": {"$ref": "#/$defs/refs"}
    }},
    "page": {"type": "object", "required": ["slug", "title", "nodes", "edges"], "properties": {
      "slug": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "subtitle": {"type": "string"},
      "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
      "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
      "groups": {"type": "array", "items": {"type": "object", "required": ["x", "y", "w", "h", "title"], "properties": {
        "id": {"type": ["string", "null"]}, "x": {"type": "number"}, "y": {"type": "number"},
        "w": {"type": "number", "exclusiveMinimum": 0}, "h": {"type": "number", "exclusiveMinimum": 0},
        "title": {"type": "string"}, "dash": {"type": "boolean"}, "fill": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }}},
      "junctions": {"type": "array", "items": {"type": "object", "required": ["id", "x", "y"], "properties": {
        "id": {"$ref": "#/$defs/id"}, "x": {"type": "number"}, "y": {"type": "number"},
        "kind": {"enum": ["data", "control", "power", "reference"]}
      }}},
      "texts": {"type": "array", "items": {"type": "object", "required": ["text", "x", "y"], "properties": {
        "text": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"},
        "size": {"type": "number", "exclusiveMinimum": 0}, "bold": {"type": "boolean"},
        "anchor": {"enum": ["start", "middle"]}, "color": {"type": "string"}
      }}},
      "notes": {"type": "array", "items": {"type": "object", "required": ["text", "y"], "properties": {
        "text": {"type": "string"}, "y": {"type": "number"}
      }}}
    }}
  }
}
